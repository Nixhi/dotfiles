// ~/.config/niri/Utils.kdl

/* --- General --- */

// Clipboard
spawn-at-startup "clipse" "-listen"

// Wallpapers
spawn-at-startup "awww-daemon"

// Panel (shell)
spawn-at-startup "ashell"

// Notify
spawn-at-startup "mako"

/* --- Other --- */

// Wallpapers
spawn-sh-at-startup "awww img ~/Pictures/Wallpapers/NightCity.jpg"
