# ~/.config/fish/conf.d/

# Commands
set -g fish_color_normal white
set -g fish_color_command green
set -g fish_color_option cyan
set -g fish_color_param yellow
set -g fish_color_status red
set -g fish_color_error red

# Symbols
set -g fish_color_comments cyan
set -g fish_color_operator cyan
set -g fish_color_cancel cyan
set -g fish_color_escape cyan
set -g fish_color_quote yellow
set -g fish_color_end cyan

# Special
set -g fish_color_redirection magenta --underline
set -g fish_color_valid_path magenta --underline
set -g fish_color_autosuggestion brblack --bold
